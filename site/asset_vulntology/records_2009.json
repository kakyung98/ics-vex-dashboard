-01:CSAFPID-00014","name":"G-150AD: Versions 3.21 and prior","advisory_id":"icsa-22-160-01","source_product_id":"CSAFPID-00014","asset_ids":[],"binding":"CSAF_known_affected","classification_accuracy_verified":false},{"key":"icsa-22-160-01:CSAFPID-00015","name":"GB-50AD: Versions 3.21 and prior","advisory_id":"icsa-22-160-01","source_product_id":"CSAFPID-00015","asset_ids":[],"binding":"CSAF_known_affected","classification_accuracy_verified":false},{"key":"icsa-22-160-01:CSAFPID-00016","name":"GB-50ADA-A: Versions 3.21 and prior","advisory_id":"icsa-22-160-01","source_product_id":"CSAFPID-00016","asset_ids":[],"binding":"CSAF_known_affected","classification_accuracy_verified":false},{"key":"icsa-22-160-01:CSAFPID-00017","name":"GB-50ADA-J: Versions 3.21 and prior","advisory_id":"icsa-22-160-01","source_product_id":"CSAFPID-00017","asset_ids":[],"binding":"CSAF_known_affected","classification_accuracy_verified":false},{"key":"icsa-22-160-01:CSAFPID-00018","name":"TE-200A: Versions 7.97 and prior","advisory_id":"icsa-22-160-01","source_product_id":"CSAFPID-00018","asset_ids":[],"binding":"CSAF_known_affected","classification_accuracy_verified":false},{"key":"icsa-22-160-01:CSAFPID-00019","name":"TE-50A: Versions 7.97 and prior","advisory_id":"icsa-22-160-01","source_product_id":"CSAFPID-00019","asset_ids":[],"binding":"CSAF_known_affected","classification_accuracy_verified":false},{"key":"icsa-22-160-01:CSAFPID-00020","name":"TW-50A: Versions 7.97 and prior","advisory_id":"icsa-22-160-01","source_product_id":"CSAFPID-00020","asset_ids":[],"binding":"CSAF_known_affected","classification_accuracy_verified":false}],"sources":[{"id":"icsa-22-160-01:v4:n0","text":"The TLS protocol and the SSL Protocol 3.0 and earlier do not properly associate renegotiation handshakes with an existing connection in some third-party products. This allows machine-in-the-middle attackers to insert data into sessions protected by TLS or SSL by sending an unauthenticated request processed retroactively by a server in a post-renegotiation context.CVE-2009-3555 has been assigned to this vulnerability. A CVSS v3 base score of 7.4 has been assigned; the CVSS vector string is (AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:H/A:H).","text_sha256":"524da180b5e0b6e9a9c4d2d8fdeaa7d846cf5a1f64195b8f4ae5e06a4f4b6070","url":"https://www.cisa.gov/news-events/ics-advisories/icsa-22-160-01","document_sha256":"688279e74f4ad5f76c0b44e4d42890e1920b950cecccfb49de868877f17c2d87","pointer":"/vulnerabilities/4/notes/0/text","product_keys":["icsa-22-160-01:CSAFPID-0001","icsa-22-160-01:CSAFPID-0002","icsa-22-160-01:CSAFPID-0003","icsa-22-160-01:CSAFPID-0004","icsa-22-160-01:CSAFPID-0005","icsa-22-160-01:CSAFPID-0006","icsa-22-160-01:CSAFPID-0007","icsa-22-160-01:CSAFPID-0008","icsa-22-160-01:CSAFPID-0009","icsa-22-160-01:CSAFPID-00010","icsa-22-160-01:CSAFPID-00011","icsa-22-160-01:CSAFPID-00012","icsa-22-160-01:CSAFPID-00013","icsa-22-160-01:CSAFPID-00014","icsa-22-160-01:CSAFPID-00015","icsa-22-160-01:CSAFPID-00016","icsa-22-160-01:CSAFPID-00017","icsa-22-160-01:CSAFPID-00018","icsa-22-160-01:CSAFPID-00019","icsa-22-160-01:CSAFPID-00020"],"scope_binding":"CVE_known_affected_product_set_candidate_not_universal_condition","subject_ambiguous":false},{"id":"nvd:CVE-2009-3555","text":"The TLS protocol, and the SSL protocol 3.0 and possibly earlier, as used in Microsoft Internet Information Services (IIS) 7.0, mod_ssl in the Apache HTTP Server 2.2.14 and earlier, OpenSSL before 0.9.8l, GnuTLS 2.8.5 and earlier, Mozilla Network Security Services (NSS) 3.12.4 and earlier, multiple Cisco products, and other products, does not properly associate renegotiation handshakes with an existing connection, which allows man-in-the-middle attackers to insert data into HTTPS sessions, and possibly other types of sessions protected by TLS or SSL, by sending an unauthenticated request that is processed retroactively by a server in a post-renegotiation context, related to a \"plaintext injection\" attack, aka the \"P