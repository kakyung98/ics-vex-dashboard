.claude/launch.json

# The function index, regenerated from the snapshots (tools/build_func_index.py, 57 MB)
data/func_index/

# General scratch output (logs, intermediate listings)
results/_*

# The L0 CPE index - regenerated from a bulk NVD scan (tools/build_cpe_index.py,
# 18 MB plus caches)
data/cpe_index.json
data/nvd_cpe_detail.json

# VEX-v2 pipeline output - regenerable (tools/vex_judge_v2.py --run).
# The inputs the certification evaluation SCORES are tracked, though. "Regenerable" is
# not "reproducible": rebuilding these caches takes hours of Joern CPG builds and LLM
# calls, so ignoring them would leave a clone unable to run /cert.html's Q3/Q4 axis or
# item #4's allbuilds scope. They come to 560 KB in total.
data/cti_extractions.json

# Joern workspace (CPG projects, regenerable scratch)
workspace/

# The NVD CPE dictionary - re-collected with tools/fetch_cpe_dictionary.py --vendors
# (932 vendors, 20 MB)
data/cpe_dictionary.state

# Product-name embeddings regenerated from the trained encoder (after
# tools/train_cpe_encoder, src/cpe_match_ai caches them on first run, 38 MB)
data/cpe_product_embeddings.npz
# The patched-build function index - regenerated from data/fixed_releases
#   python tools/build_func_index.py --build patched
data/func_index_patched/
# Evaluation datasets uploaded through the certification page (user input, not output)
data/cert_uploads/

# The Debian security tracker CVE list (27 MB) - tools/fetch_debian_refs regenerates it
# from a shallow clone. Only the derived data/debian_refs.json is committed.
data/_debian_cve_list.txt
