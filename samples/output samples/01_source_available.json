  "vulnerabilities": [
    {
      "cve": "CVE-2016-9318",
      "ids": [
        {
          "system_name": "Siemens ProductCERT Security Advisory",
          "text": "SSA-398330"
        },
        {
          "system_name": "CISA ICS Advisory",
          "text": "ICSA-23-348-10"
        }
      ],
      "title": "libxml2 does not restrict XML external entity references (CWE-611)",
      "notes": [
        {
          "category": "description",
          "title": "Vulnerability summary",
          "text": "libxml2 2.9.4 and earlier do not restrict XML external entity references, so a crafted XML document can disclose file contents or forge server-side requests."
        },
        {
          "category": "details",
          "title": "Basis for the VEX verdict",
          "text": "Source collection succeeded (source_code_available=true). Q1 component present: libxml2 2.9.4 is in the SBOM of CSAFPID-0001. Q2 vulnerable code present: the entity-handling code on the xmlParseBalancedChunkMemoryInternal path is present in the collected snapshot and the fix commit is not applied. Q3 reachability: the call graph shows a path from the XML parsing entry point (the configuration upload handler of the embedded web server) to the vulnerable function. Q4 controllability: a constraint solution confirms that external input reaches the entity declaration. The verdict on CSAFPID-0010 is therefore known_affected. CSAFPID-0011 carries libxml2 2.9.5, which contains the fix."
        }
      ],
